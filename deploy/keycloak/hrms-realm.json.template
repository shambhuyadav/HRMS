{
  "realm": "hrms",
  "displayName": "HRMS",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "registrationEmailAsUsername": true,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "editUsernameAllowed": false,
  "resetPasswordAllowed": false,
  "rememberMe": false,
  "verifyEmail": false,
  "bruteForceProtected": true,
  "permanentLockout": false,
  "failureFactor": 5,
  "waitIncrementSeconds": 60,
  "maxFailureWaitSeconds": 900,
  "minimumQuickLoginWaitSeconds": 60,
  "quickLoginCheckMilliSeconds": 1000,
  "maxDeltaTimeSeconds": 43200,
  "passwordPolicy": "length(12) and notUsername and notEmail and passwordHistory(5)",
  "otpPolicyType": "totp",
  "otpPolicyAlgorithm": "HmacSHA1",
  "otpPolicyDigits": 6,
  "otpPolicyPeriod": 30,
  "otpPolicyLookAheadWindow": 1,
  "ssoSessionIdleTimeout": 1800,
  "ssoSessionMaxLifespan": 43200,
  "accessTokenLifespan": 300,
  "accessCodeLifespan": 60,
  "accessCodeLifespanLogin": 1800,
  "internationalizationEnabled": false,
  "loginTheme": "hrms",
  "clients": [
    {
      "clientId": "hrms-web",
      "name": "HRMS",
      "description": "The HRMS web app: authorization code with PKCE (S256), public client. Its ID token is verified by the HRMS API.",
      "enabled": true,
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "frontchannelLogout": false,
      "fullScopeAllowed": false,
      "rootUrl": "__PUBLIC_ORIGIN__",
      "baseUrl": "/",
      "redirectUris": ["__PUBLIC_ORIGIN__/signed-in"],
      "webOrigins": ["__PUBLIC_ORIGIN__"],
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "__PUBLIC_ORIGIN__/",
        "backchannel.logout.session.required": "false",
        "oauth2.device.authorization.grant.enabled": "false",
        "oidc.ciba.grant.enabled": "false"
      }
    }
  ]
}
