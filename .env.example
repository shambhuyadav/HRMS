# Local development database password for npm run db:dev and npm run db:up (docker compose). Choose your own, use the same value in
# DATABASE_URL, and never reuse it in any shared or production environment.
DEV_DB_PASSWORD=replace-with-a-local-password
DATABASE_URL=postgres://hrms:replace-with-a-local-password@localhost:5432/hrms_dev
# Development-only HS256 secret (>= 32 chars). Never reuse in any shared or production environment.
DEV_TOKEN_SECRET=replace-with-a-local-random-string-of-32-plus-chars
PORT=3000
# Optional serving budgets in milliseconds (docs/09 §8.2): the starting values, used when these stay unset.
# HTTP_READ_DEADLINE_MS=3000
# DB_READ_STATEMENT_TIMEOUT_MS=2000
# DB_READ_LOCK_TIMEOUT_MS=1000
# HTTP_WRITE_DEADLINE_MS=5000
# DB_WRITE_STATEMENT_TIMEOUT_MS=4000
# DB_WRITE_LOCK_TIMEOUT_MS=2000
# HTTP_BATCH_DEADLINE_MS=120000
# DB_BATCH_STATEMENT_TIMEOUT_MS=15000
# DB_BATCH_LOCK_TIMEOUT_MS=5000
# DB_BULK_STATEMENT_TIMEOUT_MS=60000
# DB_BULK_LOCK_TIMEOUT_MS=15000
# Optional worker limits (docs/09 §7): the starting values, used when these stay unset. None is measured (G4).
# OUTBOX_RELAY_BATCH=500
# OUTBOX_RELAY_INTERVAL_MS=5000
# SCHEDULED_RUN_LEASE_MS=300000
# REMINDER_CHUNK_SIZE=100
# CELEBRATION_PAGE_SIZE=100
# CELEBRATION_RECIPIENT_BATCH=200
# SCAN_PER_TICK=200
# SCAN_MAX_ATTEMPTS=10
# SCAN_BACKOFF_BASE_MS=60000
# SCAN_BACKOFF_MAX_MS=3600000
# SCAN_TIMEOUT_MS=30000
# SCAN_PAUSE_AFTER_ERRORS=5
# GET /internal/metrics stays unregistered unless this holds a bearer token of at least 32 characters.
# HRMS_METRICS_TOKEN=
